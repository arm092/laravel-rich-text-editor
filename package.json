{
  "name": "laravel-rich-text-editor-assets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build --mode basic && vite build --mode with-code && tailwindcss -i resources/css/editor.css -o dist/rich-text-editor.css --minify",
    "dev": "vite",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint resources/js tests/js vite.config.ts",
    "check:bundles": "node scripts/check-bundles.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.9.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.0",
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-text-style": "^3.29.0",
    "@tiptap/extension-underline": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "js-beautify": "^1.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-beautify": "^1.14.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
